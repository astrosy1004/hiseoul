# Copy this file to .env.local and fill in the values from
# Supabase > Project Settings > API Keys (or "Connect" button).
# Both values are safe to use in the browser. Never put the secret /
# service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server only (no NEXT_PUBLIC_ prefix): lets AI write Skin Match explanations.
# Get it at platform.claude.com > API keys. Leave empty to use built-in wording.
ANTHROPIC_API_KEY=
